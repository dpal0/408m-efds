#!/bin/bash
# runme - sanity check for iis_source and iis_sink
set -e

cd "$(dirname "$0")"

INPUT_DIR="./test_subwindows"
OUTPUT_LOG="./results.txt"

if [ ! -d "$INPUT_DIR" ]; then
    echo "FAIL: input dir $INPUT_DIR not found"
    exit 1
fi

../test_source_sink.exe "$INPUT_DIR" "$OUTPUT_LOG"

# echo "--- $OUTPUT_LOG ---"
# cat "$OUTPUT_LOG"
# echo "--- end ---"

expected=$(ls "$INPUT_DIR"/*.txt 2>/dev/null | wc -l)
actual=$(wc -l < "$OUTPUT_LOG")
echo "expected $expected tokens, got $actual lines in log"

if [ "$expected" -eq "$actual" ]; then
    echo "PASS"
else
    echo "FAIL"
    exit 1
fi
