#!/bin/bash
# runme - sanity check for iis_source and iis_sink

# cd to the directory containing this script so paths work no matter where it's invoked from
cd "$(dirname "$0")"

INPUT_DIR="./test_subwindows"
OUTPUT_LOG="./results.txt"

# Run the test
./test_source_sink.exe "$INPUT_DIR" "$OUTPUT_LOG"
RC=$?

if [ $RC -ne 0 ]; then
    echo "test_source_sink.exe exited with code $RC"
    exit $RC
fi

# Show what got logged
echo "--- $OUTPUT_LOG ---"
cat "$OUTPUT_LOG"
echo "--- end ---"

# Quick sanity: number of lines should equal number of .txt files
expected=$(ls "$INPUT_DIR"/*.txt 2>/dev/null | wc -l)
actual=$(wc -l < "$OUTPUT_LOG")
echo "expected $expected tokens, got $actual"

if [ "$expected" -eq "$actual" ]; then
    echo "PASS"
else
    echo "FAIL"
    exit 1
fi